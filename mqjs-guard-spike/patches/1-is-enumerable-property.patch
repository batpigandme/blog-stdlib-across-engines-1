+/**
+* Tests if an object's own property is enumerable, for environments lacking `Object.prototype.propertyIsEnumerable`.
+*
+* ## Notes
+*
+* -   An own property of an object is enumerable if and only if `Object.keys` lists it.
+* -   For a primitive, the function returns `false`, as `Object.keys` cannot be relied on to accept one. Of a primitive's own properties, only a string's indices are enumerable, and `./has_string_enumerability_bug.js` detects the `false` returned for them, so `./main.js` tests indices separately.
+* -   Called as `isEnumerableProperty.call( value, property )`, like the built-in.
+*
+* @private
+* @param {*} property - property to test
+* @returns {boolean} boolean indicating if an object property is enumerable
+*
+* @example
+* var beep = {
+*     'boop': true
+* };
+*
+* var bool = isEnumerableProperty.call( beep, 'boop' );
+* // returns true
+*/
+function isEnumerableProperty( property ) {
+	var self = this; // eslint-disable-line no-invalid-this
+	if ( typeof self !== 'object' && typeof self !== 'function' ) {
+		return false;
+	}
+	if ( !hasOwnProp( self, property ) ) {
+		return false;
+	}
+	return ( objectKeys( self ).indexOf( String( property ) ) >= 0 );
+}
+
+
+// EXPORTS //
+
+module.exports = isEnumerableProperty;
